{
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 30
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "index.js"
    }
  ],
  "headers": [
    {
      "source": "/m3u8-proxy",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Requested-With, Range, Authorization, Cookie" },
        { "key": "Access-Control-Expose-Headers", "value": "Content-Range, Content-Length, Accept-Ranges, Content-Type" }
      ]
    }
  ]
}
